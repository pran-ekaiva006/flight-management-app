NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Amadeus Flight Offers API (free self-service/test tier)
# Create a free account at https://developers.amadeus.com, register an app,
# and paste the real client id/secret into .env.local
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_API_BASE_URL=https://test.api.amadeus.com
